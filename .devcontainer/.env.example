# euler-copilot-shell devcontainer 凭据模板
#
# 本文件仅作说明，不会自动加载。实际凭据通过 devcontainer.json 的 remoteEnv
# （${localEnv:KEY:}）从宿主机环境变量注入，请勿在 .env 或任何配置文件提交真实密钥。
#
# 复制到宿主机 shell 环境（如 ~/.bashrc）后 Reopen in Container 即可生效：
#   export LLM_API_KEY=xxx
#   export OPENAI_API_KEY=xxx
#   export OPENAI_API_BASE=https://api.example.com/v1
#   export OI_SKIP_SSL_VERIFY=0
#   export UV_DEFAULT_INDEX=https://mirrors.huaweicloud.com/repository/pypi/simple

LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=
OI_SKIP_SSL_VERIFY=
UV_DEFAULT_INDEX=
