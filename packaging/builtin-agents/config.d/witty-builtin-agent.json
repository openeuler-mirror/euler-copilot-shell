{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "witty-builtin-agent": {
      "description": "Witty Assistant，提供知识问答、命令查询、故障诊断、方案规划与可视化报告",
      "mode": "primary",
      "prompt": "{file:../agents/witty-builtin-agent/witty-builtin-agent.md}",
      "color": "#5F87FF",
      "permission": {
        "*": "ask",
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "task": "allow",
        "openeuler_portal_*": "allow",
        "context7_*": "allow",
        "websearch_*": "allow",
        "grep_app_*": "allow",
        "external_directory": {
          "*": "ask",
          "/tmp/**": "allow",
          "~/.local/share/opencode/**": "allow",
          "/usr/share/witty/**": "allow"
        },
        "bash": {
          "*": "allow",
          "*dnf install *": "ask",
          "*dnf download *": "ask",
          "*dnf groupinstall *": "ask",
          "*yum install *": "ask",
          "*yum localinstall *": "ask",
          "*yum download *": "ask",
          "*rpm --install *": "ask",
          "*rpm --upgrade *": "ask",
          "*rpm -i *": "ask",
          "*rpm -U *": "ask",
          "*rpm2cpio *": "ask",
          "*npm install *": "ask",
          "*npm i *": "ask",
          "*npm ci*": "ask",
          "*npx *": "ask",
          "*pip install *": "ask",
          "*pip3 install *": "ask",
          "*python -m pip install *": "ask",
          "*pipx install *": "ask",
          "*apt install *": "ask",
          "*apt-get install *": "ask",
          "*snap install *": "ask",
          "*cargo install *": "ask",
          "*go install *": "ask",
          "*gem install *": "ask",
          "*playwright install*": "ask",
          "*puppeteer browsers install*": "ask",
          "*dnf -y install *": "ask",
          "*dnf -y download *": "ask",
          "*yum -y install *": "ask",
          "*apt-get -y install *": "ask",
          "*rpm -ivh*": "ask",
          "*rpm -Uvh*": "ask",
          "*python3 -m pip install *": "ask",
          "*uv pip install *": "ask",
          "*uv add *": "ask",
          "*curl *-A *": "ask",
          "*curl *--user-agent*": "ask",
          "*wget *--user-agent*": "ask",
          "*wget *-U *": "ask",
          "*user-agent*": "ask",
          "*User-Agent*": "ask",
          "*kroki.io*": "ask",
          "*plantuml.com*": "ask"
        }
      }
    }
  },
  "mcp": {
    "openeuler_portal": {
      "type": "local",
      "command": ["npx", "-y", "openeuler-portal-mcp"],
      "environment": {
        "OPENEULER_TOKEN": "{env:OPENEULER_TOKEN}",
        "GITCODE_TOKEN": "{env:GITCODE_TOKEN}",
        "FORUM_TOKEN": "{env:FORUM_TOKEN}"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
