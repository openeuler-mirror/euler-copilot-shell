{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "witty-builtin-agent": {
      "description": "Witty Assistant，提供知识问答、命令查询、故障诊断、方案规划与可视化报告",
      "mode": "primary",
      "prompt": "{file:../agents/witty-builtin-agent/witty-builtin-agent.md}",
      "color": "#5F87FF",
      "permission": {
        "*": "ask",
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "task": "allow",
        "openeuler_portal_*": "allow",
        "external_directory": {
          "*": "ask",
          "/tmp/**": "allow",
          "~/.local/share/opencode/**": "allow",
          "/usr/share/witty/**": "allow"
        },
        "bash": "allow"
      }
    }
  },
  "mcp": {
    "openeuler_portal": {
      "type": "local",
      "command": ["npx", "-y", "openeuler-portal-mcp"],
      "environment": {
        "OPENEULER_TOKEN": "${OPENEULER_TOKEN}",
        "GITCODE_TOKEN": "${GITCODE_TOKEN}",
        "FORUM_TOKEN": "${FORUM_TOKEN}"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
