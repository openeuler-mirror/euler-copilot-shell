# shellcheck shell=bash
# Witty Bash integration [[ .Version ]]
# Source with: eval "$(witty init bash)"

if [ "${__WITTY_SHELL_INIT_LOADED:-}" != "1" ] || ! declare -F __witty_classify >/dev/null 2>&1; then
  export __WITTY_SHELL_INIT_LOADED=1
  __WITTY_BINARY="[[ .BinaryPath ]]"
  __WITTY_DEFAULT_ENABLE="[[ .ShellEnabled ]]"
  __WITTY_DEFAULT_DEBUG="[[ .ShellDebug ]]"

  __witty_debug() {
    local debug="${WITTY_SHELL_DEBUG:-}"
    if [ -z "$debug" ]; then
      debug="$__WITTY_DEFAULT_DEBUG"
    fi
    case "$debug" in
    1 | true | TRUE | True | yes | YES | Yes | on | ON | On)
      printf 'witty shell: %s\n' "$*" >&2
      ;;
    esac
  }

  __witty_should_enable() {
    local enabled="${WITTY_SHELL_ENABLE:-}"
    if [ -z "$enabled" ]; then
      enabled="$__WITTY_DEFAULT_ENABLE"
    fi
    case "$enabled" in
    0 | false | FALSE | False | no | NO | No | off | OFF | Off)
      return 1
      ;;
    esac
    [ -n "${BASH_VERSION:-}" ] || return 1
    case "${BASH_VERSINFO[0]:-0}" in
    [0-3]) return 1 ;;
    esac
    case $- in
    *i*) ;;
    *) return 1 ;;
    esac
    [ -t 0 ] && [ -t 1 ] || return 1
    return 0
  }

  __witty_is_shell_keyword() {
    case "$1" in
    [[ .ShellKeywordCase ]])
      return 0
      ;;
    esac
    return 1
  }

  __witty_is_shell_command() {
    case "$1" in
    [[ .ShellCommandCase ]])
      return 0
      ;;
    esac
    return 1
  }

  __witty_is_control() {
    local line="${1:-}"
    local -a words=()
    local first=""
    local subcommand=""
    read -r -a words <<<"$line"
    [ "${#words[@]}" -gt 0 ] || return 1
    first="${words[0],,}"
    case "$first" in
    /exit | /quit | /q | /new | /help)
      [ "${#words[@]}" -eq 1 ]
      return
      ;;
    /ask)
      [ "${#words[@]}" -ge 2 ]
      return
      ;;
    /agent | /model)
      return 0
      ;;
    /session)
      [ "${#words[@]}" -eq 1 ] && return 0
      subcommand="${words[1],,}"
      case "$subcommand" in
      list)
        [ "${#words[@]}" -eq 2 ]
        return
        ;;
      continue)
        [ "${#words[@]}" -eq 3 ]
        return
        ;;
      esac
      ;;
    esac
    return 1
  }

  __witty_has_nl_prefix() {
    local lower=""
    lower="${1,,}"
    case "$lower" in
    [[ .NLPhraseCase ]])
      return 0
      ;;
    esac
    return 1
  }

  __witty_has_nl_signal() {
    local line="${1:-}"
    local lower=""
    lower="${line,,}"

    case "$line" in
    *'?'* | *'？'* | *[一-龥]*)
      return 0
      ;;
    esac

    case "$lower" in
    [[ .NLPhraseCase ]])
      return 0
      ;;
    esac

    return 1
  }

  __witty_has_command_nl_signal() {
    local first="${1:-}"
    local lower=""
    lower="${2,,}"
    case "$first:$lower" in
    [[ .CommandNLCase ]])
      return 0
      ;;
    esac
    return 1
  }

  __witty_looks_like_shell_command() {
    case "${1:-}" in
    [A-Za-z0-9_]*)
      case "$1" in
      *[!A-Za-z0-9_.+@%-]*) return 1 ;;
      *) return 0 ;;
      esac
      ;;
    esac
    return 1
  }

  __witty_command_exists() {
    local cmd="${1:-}"
    if [ -z "$cmd" ]; then
      return 1
    fi
    if [ -n "${__WITTY_CMD_CACHE[$cmd]+x}" ]; then
      [ "${__WITTY_CMD_CACHE[$cmd]}" = "1" ] && return 0 || return 1
    fi
    if type -t -- "$cmd" >/dev/null 2>&1; then
      __WITTY_CMD_CACHE["$cmd"]=1
      return 0
    fi
    return 1
  }

  __witty_classify() {
    local line="${1:-}"
    local first=""
    local rest=""
    local compact="${line// /}"
    compact="${compact//$'\t'/}"
    compact="${compact//$'\r'/}"
    compact="${compact//$'\n'/}"
    if [ -z "$compact" ]; then
      printf 'empty\n'
      return 0
    fi

    if __witty_is_control "$line"; then
      printf 'control\n'
      return 0
    fi

    read -r first rest <<<"$line"

    case "$first" in
    \\*) first="${first#\\}" ;;
    esac
    case "$first" in
    \"*\" | \'*\') first="${first:1:-1}" ;;
    esac

    case "$first" in
    witty)
      printf 'shell\n'
      return 0
      ;;
    /* | ./* | ../* | ~/* | */*)
      printf 'shell\n'
      return 0
      ;;
    \$[A-Za-z_]* | \$[0-9]* | \$@ | \$\* | \$# | \$\? | \$\$ | \$! | \$_)
      printf 'shell\n'
      return 0
      ;;
    esac

    local backtick=$'\140'
    local dollar_paren="\$("
    local dollar_brace="\${"
    # shellcheck disable=SC2221,SC2222
    case "$line" in
    *"|"* | *">"* | *"<"* | *";"* | *"&&"* | *"||"* | *"$backtick"* | *"$dollar_paren"* | *"$dollar_brace"* | *"{"*","*"}"* | *"{"*".."*"}"*)
      printf 'shell\n'
      return 0
      ;;
    esac
    case "$line" in
    *\\)
      printf 'shell\n'
      return 0
      ;;
    esac
    case "$first" in
    [A-Za-z_]*=*)
      printf 'shell\n'
      return 0
      ;;
    esac
    if __witty_is_shell_keyword "$first"; then
      printf 'shell\n'
      return 0
    fi

    # Known commands only yield to narrow, command-prefixed question phrases.
    if __witty_is_shell_command "$first"; then
      if __witty_has_command_nl_signal "$first" "$rest"; then
        printf 'agent\n'
        return 0
      fi
      printf 'shell\n'
      return 0
    fi

    # Glob patterns as first token (e.g., *.sh)
    case "$first" in
    *\** | *\?* | *\[*\]*)
      printf 'shell\n'
      return 0
      ;;
    esac

    # Arithmetic expressions: ((...))
    case "$compact" in
    \(\(*\)\))
      printf 'shell\n'
      return 0
      ;;
    esac

    if __witty_command_exists "$first"; then
      printf 'shell\n'
      return 0
    fi

    if __witty_has_nl_prefix "$line"; then
      printf 'agent\n'
      return 0
    fi

    if __witty_looks_like_shell_command "$first"; then
      printf 'shell\n'
      return 0
    fi

    if __witty_has_nl_signal "$line"; then
      printf 'agent\n'
      return 0
    fi

    printf 'shell\n'
  }

  __witty_shell_dispatch() {
    local route="${1:-}"
    shift || true
    if [ "${1:-}" = "--" ]; then
      shift || true
    fi
    local raw="$*"
    builtin history -s -- "$raw" 2>/dev/null || true
    if [ "$route" = "control" ] && [ "${raw,,}" = "/new" ]; then
      __WITTY_FORCE_NEXT=1
    fi
    case "$route" in
    agent)
      if [ "${__WITTY_FORCE_NEXT:-0}" = "1" ]; then
        unset __WITTY_FORCE_NEXT
        command "$__WITTY_BINARY" ask --new -- "$raw"
      else
        command "$__WITTY_BINARY" ask -- "$raw"
      fi
      ;;
    control)
      command "$__WITTY_BINARY" shell-control -- "$raw"
      ;;
    *)
      printf 'witty shell: unknown route %s\n' "$route" >&2
      return 64
      ;;
    esac
  }

  __witty_debug_hook() {
    local cmd="${BASH_COMMAND:-}"
    [ -z "$cmd" ] && return 0
    local enabled="${WITTY_SHELL_ENABLE:-}"
    if [ -z "$enabled" ]; then
      enabled="$__WITTY_DEFAULT_ENABLE"
    fi
    case "$enabled" in
    0 | false | FALSE | False | no | NO | No | off | OFF | Off)
      return 0
      ;;
    esac
    local route=""
    route="$(__witty_classify "$cmd")"
    __witty_debug "classify ${route}: ${cmd}"
    case "$route" in
    empty | shell)
      return 0
      ;;
    agent | control)
      __witty_shell_dispatch "$route" -- "$cmd"
      return 1
      ;;
    esac
    return 0
  }

  __witty_command_not_found_handle() {
    local cmd="$1"
    shift || true
    if __witty_should_enable 2>/dev/null; then
      command "$__WITTY_BINARY" ask -- "$cmd $*"
      return $?
    fi
    return 127
  }

  __witty_install_bindings() {
    if [ "${__WITTY_BINDINGS_INSTALLED:-}" = "1" ]; then
      return 0
    fi
    __witty_should_enable || return 0

    declare -gA __WITTY_CMD_CACHE 2>/dev/null || true

    shopt -s extdebug

    local _wit_hig="__witty_shell_dispatch *"
    if [ -n "${HISTIGNORE:-}" ]; then
      case ":$HISTIGNORE:" in
      *":$_wit_hig:"*) ;;
      *) HISTIGNORE="${_wit_hig}:${HISTIGNORE}" ;;
      esac
    else
      HISTIGNORE="${_wit_hig}"
    fi
    export HISTIGNORE

    __witty_prev_debug_trap=""
    if [ "$(trap -p DEBUG)" ]; then
      __witty_prev_debug_trap=$(trap -p DEBUG)
    fi
    trap '__witty_debug_hook' DEBUG

    if [ "$(type -t command_not_found_handle 2>/dev/null)" = "function" ]; then
      __witty_prev_command_not_found_handle=$(declare -f command_not_found_handle)
    fi
    # shellcheck disable=SC2329
    command_not_found_handle() { __witty_command_not_found_handle "$@"; }

    __WITTY_BINDINGS_INSTALLED=1
    __witty_debug 'bindings installed'
  }

  __witty_uninstall_bindings() {
    if [ "${__WITTY_BINDINGS_INSTALLED:-}" != "1" ]; then
      return 0
    fi
    if [ -n "$__witty_prev_debug_trap" ]; then
      eval "$__witty_prev_debug_trap"
    else
      trap - DEBUG
    fi
    shopt -u extdebug
    if [ -n "${__witty_prev_command_not_found_handle:-}" ]; then
      eval "$__witty_prev_command_not_found_handle"
    else
      unset -f command_not_found_handle 2>/dev/null || true
    fi
    __WITTY_BINDINGS_INSTALLED=0
    __witty_debug 'bindings uninstalled'
  }

  __witty_try_install() {
    # Deferred installer called from PROMPT_COMMAND on the first interactive
    # prompt. By this point ~/.bashrc has already been sourced, so
    # WITTY_SHELL_ENABLE reflects the user's per-shell preference.
    if [ "${__WITTY_PROMPT_INSTALL_DONE:-}" = "1" ]; then
      return 0
    fi
    __WITTY_PROMPT_INSTALL_DONE=1
    __witty_install_bindings
  }

  # Defer installation to first prompt so that ~/.bashrc can disable it.
  # PROMPT_COMMAND only executes in interactive shells — non-interactive
  # shells (cron, scp, git hooks) will never trigger the installer.
  if [ -n "${PROMPT_COMMAND:-}" ]; then
    PROMPT_COMMAND="${PROMPT_COMMAND};__witty_try_install"
  else
    PROMPT_COMMAND="__witty_try_install"
  fi
fi
